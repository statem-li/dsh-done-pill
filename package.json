{
  "name": "dsh-done-pill",
  "version": "0.2.9",
  "description": "DSH 对话完成胶囊：顶部悬浮消息胶囊（原 webui done-pill 拆出）——任一会话回合完成提醒、点击跳会话、悬停查看记录全文、可拖拽定位、健康提醒与字体/缩放设置。零 DSH 源码改动，可与 dsh-webui 并存（webui 关闭 donePill 模块即可）。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "done-pill",
    "notification",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/statem-li/dsh-done-pill.git"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "scripts",
    "build.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "node build.mjs",
    "smoke": "node scripts/smoke-client.mjs",
    "smoke:host": "node scripts/smoke-host.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
